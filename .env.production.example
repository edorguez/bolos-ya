# =============================================================================
# Merki — Production Environment Variables
# =============================================================================
# Copy this file to .env on your VPS, fill in all values, then run:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
# =============================================================================

# Domain (used by Caddy for auto TLS + reverse proxy routing)
DOMAIN=somosmerki.app

# Server
PORT=8080
SERVER_HOST=0.0.0.0
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# Database (PostgreSQL)
DATABASE_NAME=merki_db
DATABASE_USER=merki_user
DATABASE_PASSWORD=

# Redis
REDIS_DB=0
REDIS_PASSWORD=

# Auth Server (standalone better-auth service)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://auth-server:3001

# Internal service-to-service secret (shared by Go backend and auth-server).
# Used to authenticate auth-server → Go calls (e.g. password reset email).
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# Deep link base for the password reset email (opens the mobile app)
RESET_PASSWORD_URL=https://auth.somosmerki.app/reset-password

# Google OAuth (for better-auth social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS S3 (for premium user image storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=merki-images

# Cloudflare (for Caddy DNS challenge — SSL certificate validation)
CLOUDFLARE_API_TOKEN=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME="Merki"
EMAIL_IMAGE_BASE_URL=https://somosmerki.app
EMAIL_APP_URL=https://somosmerki.app
EMAIL_SUPPORT_EMAIL=soporte@somosmerki.app
EMAIL_SUPPORT_PHONE=+58 412-XXX-XXXX
