# =============================================================================
# Bolos Ya — Production Environment Variables
# =============================================================================
# Copy this file to .env on your VPS, fill in all values, then run:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
# =============================================================================

# Domain (used by Caddy for auto TLS + reverse proxy routing)
DOMAIN=edezco.com

# Server
PORT=8080
SERVER_HOST=0.0.0.0
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# Database (PostgreSQL)
DATABASE_NAME=bolos_ya_db
DATABASE_USER=bolos_ya_user
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Auth Server (standalone better-auth service)
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_32
BETTER_AUTH_URL=http://auth-server:3001

# Google OAuth (for better-auth social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS S3 (for premium user image storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=bolos-ya-images

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@YOUR_DOMAIN
RESEND_FROM_NAME="Bolos Ya"
