<!DOCTYPE html>
<html lang="es">
{{template "email-head" (dict "Title" "Restablece tu contraseña")}}
<body style="margin:0;padding:0;background-color:#fbfaf9;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fbfaf9;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        {{template "email-logo" .}}

        <div style="height:28px;line-height:28px;font-size:0;">&nbsp;</div>

        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;background-color:#ffffff;border-radius:24px;border:1px solid #f2f0ed;">
          <tr>
            <td align="center" style="padding:40px 40px 36px;">
              <h1 style="margin:0 0 16px 0;font-family:Fraunces,Georgia,'Times New Roman',serif;font-size:32px;font-weight:700;line-height:1.15;letter-spacing:-0.8px;color:#343433;">Hola, {{.Name}}</h1>

              <p style="margin:0 0 16px 0;font-family:Inter,Arial,sans-serif;font-size:15px;font-weight:400;line-height:1.6;letter-spacing:-0.2px;color:#474645;">
                Recibimos una solicitud para restablecer la contraseña de tu cuenta en <strong>Merki</strong>.
              </p>

              <p style="margin:0 0 28px 0;font-family:Inter,Arial,sans-serif;font-size:15px;font-weight:400;line-height:1.6;letter-spacing:-0.2px;color:#474645;">
                Toca el botón para crear una nueva contraseña. El enlace es válido por 1 hora.
              </p>

              {{template "email-cta" (dict "URL" .ResetURL "Label" "Restablecer contraseña")}}

              <p style="margin:24px 0 4px 0;font-family:Inter,Arial,sans-serif;font-size:12px;line-height:1.58;letter-spacing:-0.14px;color:#848281;">
                Si el botón no funciona, copia y pega este enlace en tu navegador:
              </p>
              <p style="margin:0 0 24px 0;font-family:Inter,Arial,sans-serif;font-size:12px;line-height:1.58;letter-spacing:-0.14px;color:#0090ff;word-break:break-all;">{{.ResetURL}}</p>

              <p style="margin:0;font-family:Inter,Arial,sans-serif;font-size:12px;line-height:1.58;letter-spacing:-0.14px;color:#848281;">
                Si no solicitaste este cambio, puedes ignorar este mensaje y tu contraseña seguirá igual.
              </p>
            </td>
          </tr>
          {{template "email-footer" .}}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
