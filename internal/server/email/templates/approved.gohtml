<!DOCTYPE html>
<html lang="es">
{{template "email-head" (dict "Title" "Pago aprobado - Merki")}}
<body style="margin:0;padding:0;background-color:#fbfaf9;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fbfaf9;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        {{template "email-logo" .}}

        <div style="height:28px;line-height:28px;font-size:0;">&nbsp;</div>

        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;background-color:#ffffff;border-radius:24px;border:1px solid #f2f0ed;">
          <tr>
            <td align="center" style="padding:40px 40px 36px;">
              {{template "email-badge-success"}}

              <h1 style="margin:0 0 12px 0;font-family:Fraunces,Georgia,'Times New Roman',serif;font-size:32px;font-weight:700;line-height:1.15;letter-spacing:-0.8px;color:#343433;">¡Felicidades, {{.Name}}!</h1>

              <p style="margin:0 0 24px 0;font-family:Inter,Arial,sans-serif;font-size:15px;font-weight:400;line-height:1.6;letter-spacing:-0.2px;color:#474645;">
                Tu pago ha sido aprobado exitosamente. Ya disfrutas de <strong>Merki Premium</strong> sin anuncios y con acceso a todas las funciones de la app.
              </p>

              <table role="presentation" cellpadding="0" cellspacing="0" align="center" style="margin:0 auto 28px auto;width:100%;">
                <tr>
                  <td align="center" bgcolor="#FBE8D6" style="background-color:#FBE8D6;border-radius:10px;padding:18px 24px;">
                    <p style="margin:0;font-family:Inter,Arial,sans-serif;font-size:12px;font-weight:500;line-height:1.58;letter-spacing:-0.14px;color:#7C3E12;">Eres premium hasta el</p>
                    <p style="margin:2px 0 0 0;font-family:Inter,Arial,sans-serif;font-size:19px;font-weight:600;line-height:1.3;letter-spacing:-0.25px;color:#2A1C0E;">{{.PremiumUntil}}</p>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 28px 0;font-family:Inter,Arial,sans-serif;font-size:15px;font-weight:400;line-height:1.6;letter-spacing:-0.2px;color:#474645;">
                Gracias por apoyar a Merki. Sigue llevando el control de tus compras en el supermercado.
              </p>

              {{template "email-cta" (dict "URL" .AppURL "Label" "Ir a Merki")}}
            </td>
          </tr>
          {{template "email-footer" .}}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
