<!DOCTYPE html>
<html lang="es">
{{template "email-head" (dict "Title" "Bienvenido a Merki")}}
<body style="margin:0;padding:0;background-color:#fbfaf9;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fbfaf9;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        {{template "email-logo" .}}

        <div style="height:28px;line-height:28px;font-size:0;">&nbsp;</div>

        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;background-color:#ffffff;border-radius:24px;border:1px solid #f2f0ed;">
          <tr>
            <td style="background-color:#f8f7f4;border-radius:24px 24px 0 0;padding:32px 32px 24px;">
              <img src="{{.ImageBaseURL}}/merki-illustration.png" alt="" width="400" height="400" style="display:block;width:400px;max-width:100%;height:auto;border:0;outline:none;margin:0 auto;" />
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:36px 40px 32px;">
              <h1 style="margin:0 0 16px 0;font-family:Fraunces,Georgia,'Times New Roman',serif;font-size:32px;font-weight:700;line-height:1.15;letter-spacing:-0.8px;color:#343433;">¡Bienvenido, {{.Name}}!</h1>

              <p style="margin:0 0 16px 0;font-family:Inter,Arial,sans-serif;font-size:15px;font-weight:400;line-height:1.6;letter-spacing:-0.2px;color:#474645;">
                Gracias por registrarte en <strong>Merki</strong>. Ahora puedes guardar tu historial de compras, crear listas y llevar el control de tus gastos en el supermercado — todo en Bolívares y USD al instante.
              </p>

              <table role="presentation" cellpadding="0" cellspacing="0" align="center" style="margin:24px auto 32px auto;width:100%;">
                <tr>
                  <td align="center" bgcolor="#f8f7f4" style="background-color:#f8f7f4;border-radius:10px;border:1px solid #f2f0ed;padding:14px 20px;">
                    <p style="margin:0;font-family:Inter,Arial,sans-serif;font-size:12px;font-weight:500;line-height:1.58;letter-spacing:-0.14px;color:#848281;">Tu correo registrado</p>
                    <p style="margin:2px 0 0 0;font-family:Inter,Arial,sans-serif;font-size:15px;font-weight:600;line-height:1.4;letter-spacing:-0.2px;color:#343433;">{{.Email}}</p>
                  </td>
                </tr>
              </table>

              {{template "email-cta" (dict "URL" .AppURL "Label" "Empezar a usar Merki")}}

              <p style="margin:24px 0 0 0;font-family:Inter,Arial,sans-serif;font-size:12px;line-height:1.58;letter-spacing:-0.14px;color:#848281;">
                Si no creaste esta cuenta, puedes ignorar este mensaje.
              </p>
            </td>
          </tr>
          {{template "email-footer" .}}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
