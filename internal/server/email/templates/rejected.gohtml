<!DOCTYPE html>
<html lang="es">
{{template "email-head" (dict "Title" "Pago rechazado - Merki")}}
<body style="margin:0;padding:0;background-color:#fbfaf9;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fbfaf9;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        {{template "email-logo" .}}

        <div style="height:28px;line-height:28px;font-size:0;">&nbsp;</div>

        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;background-color:#ffffff;border-radius:24px;border:1px solid #f2f0ed;">
          <tr>
            <td align="center" style="padding:40px 40px 36px;">
              {{template "email-badge-error"}}

              <h1 style="margin:0 0 12px 0;font-family:Fraunces,Georgia,'Times New Roman',serif;font-size:32px;font-weight:700;line-height:1.15;letter-spacing:-0.8px;color:#343433;">Lo sentimos, {{.Name}}</h1>

              <p style="margin:0 0 20px 0;font-family:Inter,Arial,sans-serif;font-size:15px;font-weight:400;line-height:1.6;letter-spacing:-0.2px;color:#474645;">
                No pudimos procesar tu pago por el siguiente motivo:
              </p>

              <table role="presentation" cellpadding="0" cellspacing="0" align="center" style="margin:0 auto 24px auto;width:100%;">
                <tr>
                  <td align="center" bgcolor="#fef2f2" style="background-color:#fef2f2;border:1px solid #fee2e2;border-radius:10px;padding:16px 24px;">
                    <p style="margin:0;font-family:Inter,Arial,sans-serif;font-size:15px;font-weight:600;line-height:1.5;letter-spacing:-0.2px;color:#ff2b3a;">{{.Reason}}</p>
                  </td>
                </tr>
              </table>

              {{if .CustomMessage}}
              <p style="margin:0 0 24px 0;font-family:Inter,Arial,sans-serif;font-size:15px;font-weight:400;line-height:1.6;letter-spacing:-0.2px;color:#474645;">
                {{.CustomMessage}}
              </p>
              {{end}}

              <p style="margin:0 0 24px 0;font-family:Inter,Arial,sans-serif;font-size:15px;font-weight:400;line-height:1.6;letter-spacing:-0.2px;color:#474645;">
                Puedes intentar nuevamente desde la app o contactarnos y con gusto te ayudamos.
              </p>

              {{template "email-cta" (dict "URL" (printf "mailto:%s" .SupportEmail) "Label" "Contactar soporte")}}

              <p style="margin:24px 0 0 0;font-family:Inter,Arial,sans-serif;font-size:12px;line-height:1.58;letter-spacing:-0.14px;color:#848281;">
                Correo: <a href="mailto:{{.SupportEmail}}" style="color:#A3521B;text-decoration:underline;">{{.SupportEmail}}</a><br>
                Teléfono: {{.SupportPhone}}
              </p>
            </td>
          </tr>
          {{template "email-footer" .}}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
