{
	email admin@{$DOMAIN}
}

# Landing page (public — Cloudflare handles HTTPS at edge)
http://{$DOMAIN}, http://www.{$DOMAIN} {
	reverse_proxy web:80
}

# API backend
api.{$DOMAIN} {
	reverse_proxy server:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# Auth server
auth.{$DOMAIN} {
	reverse_proxy auth-server:3001 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# Admin dashboard + landing page (same SPA, DNS-only for auto TLS)
admin.{$DOMAIN} {
	reverse_proxy web:80
}
