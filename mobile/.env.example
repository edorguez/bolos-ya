# Client-side (bundled in the app — must use EXPO_PUBLIC_ prefix)
# For physical Android devices, set EXPO_PUBLIC_DEVICE_HOST in .env.local
# to your Mac's local IP (e.g. EXPO_PUBLIC_DEVICE_HOST=192.168.1.50)
# or Bonjour hostname (e.g. EXPO_PUBLIC_DEVICE_HOST=MacBook-Pro.local)
EXPO_PUBLIC_BETTER_AUTH_URL=http://localhost:3001/api/auth
EXPO_PUBLIC_GO_BACKEND_URL=http://localhost:8080/api/v1
