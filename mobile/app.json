{
  "expo": {
    "name": "Merki",
    "slug": "merki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/system/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/system/merki_logo_text_vertical.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "merki",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera for OCR scanning.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photo library for OCR scanning."
      },
      "bundleIdentifier": "com.merki.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/system/android-icon-foreground.png",
        "backgroundImage": "./assets/system/android-icon-background.png",
        "monochromeImage": "./assets/system/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.merki.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "webpack"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/system/merki_logo_text_vertical.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for OCR scanning."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.6"
          },
          "android": {
            "compileSdkVersion": 36,
            "buildConfig": true,
            "abiFilters": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1019164072675452~9310060521",
          "iosAppId": "ca-app-pub-1019164072675452~1291969706"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./app"
      },
      "eas": {
        "projectId": "af409113-dc59-4e2e-9801-8f901072bb6c"
      }
    }
  }
}
